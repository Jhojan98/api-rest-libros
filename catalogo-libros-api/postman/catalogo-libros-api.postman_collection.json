{
  "info": {
    "name": "Catálogo de Libros API",
    "description": "Colección para probar los endpoints de la API REST de catálogo de libros.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": ["{{base_url}}"],
          "path": [""]
        }
      }
    },
    {
      "name": "Listar libros",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/libros",
          "host": ["{{base_url}}"],
          "path": ["libros"]
        }
      }
    },
    {
      "name": "Filtrar libros por autor (query param)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/libros?autor=Orwell",
          "host": ["{{base_url}}"],
          "path": ["libros"],
          "query": [
            { "key": "autor", "value": "Orwell" }
          ]
        }
      }
    },
    {
      "name": "Filtrar libros por disponibilidad (query param)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/libros?disponible=true",
          "host": ["{{base_url}}"],
          "path": ["libros"],
          "query": [
            { "key": "disponible", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "Obtener libro por id (path param)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/libros/1",
          "host": ["{{base_url}}"],
          "path": ["libros", "1"]
        }
      }
    },
    {
      "name": "Crear libro",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Rayuela\",\n  \"autor\": \"Julio Cortázar\",\n  \"genero\": \"novela\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/libros",
          "host": ["{{base_url}}"],
          "path": ["libros"]
        }
      }
    },
    {
      "name": "Actualizar libro",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"disponible\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/libros/2",
          "host": ["{{base_url}}"],
          "path": ["libros", "2"]
        }
      }
    },
    {
      "name": "Eliminar libro",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/libros/3",
          "host": ["{{base_url}}"],
          "path": ["libros", "3"]
        }
      }
    }
  ]
}
